<!--
  Stereo calibration diagnostic controls (Packet B). UIKit units are centimetres: the panel is 70 cm wide and is
  placed at scale 1 by src/cinematic/stereo-calibration.ts. Plain ASCII only (local MSDF font).
-->
<style>
  .root {
    flex-direction: column;
    align-items: center;
    width: 70;
    padding-top: 2;
    padding-bottom: 2;
    padding-left: 2.6;
    padding-right: 2.6;
    border-radius: 1.6;
    background-color: rgba(8, 10, 14, 0.82);
  }

  .title {
    font-size: 3;
    font-weight: 500;
    line-height: 1.25;
    color: rgba(255, 246, 228, 0.96);
    text-align: center;
  }

  .status {
    margin-top: 1;
    margin-bottom: 1.6;
    font-size: 2.2;
    line-height: 1.25;
    color: rgba(180, 200, 220, 0.92);
    text-align: center;
  }

  .row {
    flex-direction: row;
    justify-content: space-between;
    gap: 1.6;
  }

  .btn {
    width: 15;
    padding-top: 2;
    padding-bottom: 2;
    align-items: center;
    justify-content: center;
    border-radius: 1.2;
    background-color: rgba(43, 58, 85, 0.96);
    font-size: 2.6;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.98);
    text-align: center;
    cursor: pointer;
  }
</style>
<div class="root">
  <div class="title">Stereo calibration - non-final diagnostic</div>
  <div id="Stereo_Status" class="status">Loading...</div>
  <div class="row">
    <button id="Stereo_Start" class="btn">Start</button>
    <button id="Stereo_Pause" class="btn">Pause</button>
    <button id="Stereo_Resume" class="btn">Resume</button>
    <button id="Stereo_Replay" class="btn">Replay</button>
  </div>
</div>
